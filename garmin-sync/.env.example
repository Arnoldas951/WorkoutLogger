# Copy to .env in the REPO ROOT (next to docker-compose.yml), not here.
# .env is already gitignored - verified against this repo's .gitignore.

# ---------------------------------------------------------------------------
# Your real Garmin Connect account - the same login you use in the Garmin
# Connect app. Garmin has no app passwords, no personal OAuth and no read-only
# tokens, so there is no lesser credential to use instead.
#
# The password is needed for the FIRST login only. After that a refresh token
# is stored in the garmin-tokens volume and rotates on its own, so you can
# blank GARMIN_PASSWORD out below and the sync keeps working.
# ---------------------------------------------------------------------------
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# ---------------------------------------------------------------------------
# NOT a Garmin value. This is the integer primary key from your own Users
# table - which WorkoutLogger account these rows belong to. Find it with:
#
#   docker compose exec db psql -U postgres -d workoutlogger \
#       -c 'select "Id", "Email" from "Users";'
# ---------------------------------------------------------------------------
GARMIN_SYNC_USER_ID=1

# How far back a backfill reaches. Incremental runs ignore this.
GARMIN_SYNC_DAYS=90

# ---------------------------------------------------------------------------
# Required even though the sidecar never uses it. Compose interpolates the whole
# file before running any service, so the api service's ${JWT_KEY:?...} is
# evaluated even by `docker compose run garmin-sync`.
#
# Leave it invalid while you are only running the sidecar. Before running the
# dockerised api, set it to the SAME key already in user-secrets
# (`dotnet user-secrets list`) - a different one invalidates every token the
# native API issued, which signs the Android client out and clears its local
# database along with anything unsynced.
# ---------------------------------------------------------------------------
JWT_KEY=REPLACE_ME

# Optional. By default the sidecar writes to the compose `db` container. If your
# app's data lives in a Postgres somewhere else, point it there instead:
# GARMIN_SYNC_DSN=host=host.docker.internal dbname=workoutlogger user=postgres password=tainted
